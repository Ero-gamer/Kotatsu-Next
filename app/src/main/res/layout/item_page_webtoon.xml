<?xml version="1.0" encoding="utf-8"?>
<org.koitharu.kotatsu.reader.ui.pager.webtoon.WebtoonFrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:defaultFocusHighlightEnabled="false">

	<org.koitharu.kotatsu.reader.ui.pager.webtoon.WebtoonImageView
		android:id="@+id/ssiv"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:defaultFocusHighlightEnabled="false"
		android:minHeight="1dp"
		app:panEnabled="false"
		app:quickScaleEnabled="false"
		app:zoomEnabled="false" />

	<org.koitharu.kotatsu.core.image.CoilImageView
		android:id="@+id/animatedView"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:adjustViewBounds="true"
		android:scaleType="fitCenter"
		android:visibility="gone" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/button_anim_toggle"
		style="?materialIconButtonFilledTonalStyle"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:layout_gravity="start|bottom"
		android:layout_margin="@dimen/margin_small"
		android:contentDescription="@string/animation_pause"
		android:visibility="gone"
		app:icon="@drawable/ic_action_pause" />

	<SeekBar
		android:id="@+id/seek_anim"
		android:layout_width="match_parent"
		android:layout_height="40dp"
		android:layout_gravity="bottom"
		android:layout_marginStart="56dp"
		android:layout_marginEnd="56dp"
		android:layout_marginBottom="@dimen/margin_small"
		android:contentDescription="@string/animation_seek"
		android:visibility="gone" />

	<LinearLayout
		android:id="@+id/layout_anim_controls"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_horizontal|bottom"
		android:layout_marginBottom="48dp"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:visibility="gone">

		<ImageButton
			android:id="@+id/button_anim_prev"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:background="?selectableItemBackgroundBorderless"
			android:contentDescription="@string/animation_prev_frame"
			android:src="@drawable/ic_prev" />

		<TextView
			android:id="@+id/text_anim_time"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:minWidth="88dp"
			android:gravity="center"
			android:singleLine="true"
			android:textAppearance="?attr/textAppearanceBodyMedium" />

		<ImageButton
			android:id="@+id/button_anim_next"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:background="?selectableItemBackgroundBorderless"
			android:contentDescription="@string/animation_next_frame"
			android:src="@drawable/ic_next" />

		<TextView
			android:id="@+id/button_anim_speed"
			android:layout_width="wrap_content"
			android:layout_height="40dp"
			android:background="?selectableItemBackgroundBorderless"
			android:contentDescription="@string/animation_speed"
			android:gravity="center"
			android:minWidth="48dp"
			android:textAppearance="?attr/textAppearanceLabelLarge" />

		<ImageButton
			android:id="@+id/button_anim_save"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:background="?selectableItemBackgroundBorderless"
			android:contentDescription="@string/animation_save_frame"
			android:src="@drawable/ic_save" />
	</LinearLayout>


	<include layout="@layout/layout_page_info" />

</org.koitharu.kotatsu.reader.ui.pager.webtoon.WebtoonFrameLayout>
