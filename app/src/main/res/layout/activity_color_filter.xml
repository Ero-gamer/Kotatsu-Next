<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		tools:navigationIcon="@drawable/abc_ic_clear_material"
		tools:title="@string/color_correction">

		<Button
			android:id="@+id/button_done"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="end"
			android:layout_marginHorizontal="@dimen/toolbar_button_margin"
			android:text="@string/done" />

	</com.google.android.material.appbar.MaterialToolbar>

	<ScrollView
		android:id="@+id/scrollView"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:clipToPadding="false"
		android:overScrollMode="ifContentScrolls">

		<androidx.constraintlayout.widget.ConstraintLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="@dimen/margin_normal">

			<!-- ── Preview images ── -->

			<org.koitharu.kotatsu.image.ui.CoverImageView
				android:id="@+id/imageView_before"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:padding="2dp"
				android:scaleType="centerCrop"
				app:allowRgb565="false"
				app:decodeRegion="true"
				app:layout_constraintDimensionRatio="W,14:9"
				app:layout_constraintEnd_toStartOf="@id/imageView_arrow"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent"
				app:shapeAppearance="?shapeAppearanceCornerLarge"
				app:strokeColor="?colorOutline"
				app:strokeWidth="1dp"
				tools:src="@tools:sample/backgrounds/scenic" />

			<com.google.android.material.progressindicator.CircularProgressIndicator
				android:id="@+id/progress_before"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:indeterminate="true"
				app:layout_constraintBottom_toBottomOf="@id/imageView_before"
				app:layout_constraintEnd_toEndOf="@id/imageView_before"
				app:layout_constraintStart_toStartOf="@id/imageView_before"
				app:layout_constraintTop_toTopOf="@id/imageView_before" />

			<ImageView
				android:id="@+id/imageView_arrow"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:contentDescription="@null"
				android:padding="@dimen/margin_normal"
				android:src="@drawable/ic_arrow_forward"
				app:layout_constraintBottom_toBottomOf="@id/imageView_before"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="@id/imageView_before" />

			<com.google.android.material.imageview.ShapeableImageView
				android:id="@+id/imageView_after"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:padding="2dp"
				android:scaleType="centerCrop"
				app:layout_constraintDimensionRatio="W,14:9"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toEndOf="@id/imageView_arrow"
				app:layout_constraintTop_toTopOf="parent"
				app:shapeAppearance="?shapeAppearanceCornerLarge"
				app:strokeColor="?colorOutline"
				app:strokeWidth="1dp"
				tools:src="@tools:sample/backgrounds/scenic" />

			<com.google.android.material.progressindicator.CircularProgressIndicator
				android:id="@+id/progress_after"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:indeterminate="true"
				app:layout_constraintBottom_toBottomOf="@id/imageView_after"
				app:layout_constraintEnd_toEndOf="@id/imageView_after"
				app:layout_constraintStart_toStartOf="@id/imageView_after"
				app:layout_constraintTop_toTopOf="@id/imageView_after" />

			<!-- ── Toggles ── -->

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switch_invert"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:text="@string/invert_colors"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/imageView_before" />

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switch_grayscale"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:text="@string/grayscale"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/switch_invert" />

			<!-- ── Brightness (CPU ColorMatrix) ── -->

			<TextView
				android:id="@+id/textView_brightness"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_normal"
				android:text="@string/brightness"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/switch_grayscale" />

			<com.google.android.material.slider.Slider
				android:id="@+id/slider_brightness"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_small"
				android:value="0.0"
				android:valueFrom="-1.0"
				android:valueTo="1.0"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/textView_brightness" />

			<!-- ── Contrast (CPU ColorMatrix) ── -->

			<TextView
				android:id="@+id/textView_contrast"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_small"
				android:text="@string/contrast"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/slider_brightness" />

			<com.google.android.material.slider.Slider
				android:id="@+id/slider_contrast"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_small"
				android:value="0.0"
				android:valueFrom="-1.0"
				android:valueTo="1.0"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/textView_contrast" />

			<!-- ── Saturation (CPU ColorMatrix) ── -->

			<TextView
				android:id="@+id/textView_saturation"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_small"
				android:text="@string/saturation"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/slider_contrast" />

			<com.google.android.material.slider.Slider
				android:id="@+id/slider_saturation"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_small"
				android:value="0.0"
				android:valueFrom="-1.0"
				android:valueTo="1.0"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/textView_saturation" />

			<!-- ── Vibrance (GPU shader — u_enableVibrance) ── -->

			<TextView
				android:id="@+id/textView_vibrance"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_small"
				android:text="@string/vibrance"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/slider_saturation" />

			<com.google.android.material.slider.Slider
				android:id="@+id/slider_vibrance"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_small"
				android:value="0.0"
				android:valueFrom="0.0"
				android:valueTo="1.0"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/textView_vibrance" />

			<!-- ── RCAS + USM sharpen — u_enableRcasUsm / u_rcasUsmIntensity (GPU shader) ── -->

			<TextView
				android:id="@+id/textView_rcas_usm"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_normal"
				android:text="@string/sharpen_rcas_usm"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/slider_vibrance" />

			<com.google.android.material.slider.Slider
				android:id="@+id/slider_rcas_usm"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_small"
				android:value="0.0"
				android:valueFrom="0.0"
				android:valueTo="1.0"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/textView_rcas_usm" />

			<!-- ── Adaptive-Sharpen, smoothstep edge — u_enableAdaptiveSmoothstep / u_adaptiveSmoothstepIntensity (GPU shader) ── -->

			<TextView
				android:id="@+id/textView_adaptive_smoothstep"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_normal"
				android:text="@string/sharpen_adaptive_smoothstep"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/slider_rcas_usm" />

			<com.google.android.material.slider.Slider
				android:id="@+id/slider_adaptive_smoothstep"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_small"
				android:value="0.0"
				android:valueFrom="0.0"
				android:valueTo="1.0"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/textView_adaptive_smoothstep" />

			<!-- ── Adaptive-Sharpen, true sigmoid edge — u_enableAdaptiveSigmoid / u_adaptiveSigmoidIntensity (GPU shader) ── -->

			<TextView
				android:id="@+id/textView_adaptive_sigmoid"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_normal"
				android:text="@string/sharpen_adaptive_sigmoid"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/slider_adaptive_smoothstep" />

			<com.google.android.material.slider.Slider
				android:id="@+id/slider_adaptive_sigmoid"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_small"
				android:value="0.0"
				android:valueFrom="0.0"
				android:valueTo="1.0"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/textView_adaptive_sigmoid" />

			<!-- ── Denoise (GPU shader — u_enableDenoise / u_denoiseStrength) ── -->

			<TextView
				android:id="@+id/textView_denoise"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_normal"
				android:text="@string/denoise"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/slider_adaptive_sigmoid" />

			<com.google.android.material.slider.Slider
				android:id="@+id/slider_denoise"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_small"
				android:value="0.0"
				android:valueFrom="0.0"
				android:valueTo="1.0"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/textView_denoise" />

			<!-- Dither and Grain sliders REMOVED — CPU loops eliminated -->

			<!-- ── Line Darkening (GPU shader — u_enableDarken) ── -->

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switch_line_darken"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_normal"
				android:text="@string/line_darkening"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/slider_denoise" />

			<!-- ── Book effect ── -->

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switch_book"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_normal"
				android:text="@string/book_effect"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/switch_line_darken" />

			<Button
				android:id="@+id/button_reset"
				style="?materialButtonOutlinedStyle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:text="@string/reset"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toBottomOf="@id/switch_book" />

		</androidx.constraintlayout.widget.ConstraintLayout>

	</ScrollView>

</LinearLayout>
