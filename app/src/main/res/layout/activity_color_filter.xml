<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		tools:navigationIcon="@drawable/abc_ic_clear_material"
		tools:title="@string/color_correction">

		<Button
			android:id="@+id/button_done"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="end"
			android:layout_marginHorizontal="@dimen/toolbar_button_margin"
			android:text="@string/done" />

	</com.google.android.material.appbar.MaterialToolbar>

	<ScrollView
		android:id="@+id/scrollView"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:clipToPadding="false"
		android:overScrollMode="ifContentScrolls">

		<androidx.constraintlayout.widget.ConstraintLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="@dimen/margin_normal">

			<!-- ── Preview images ── -->

			<org.koitharu.kotatsu.image.ui.CoverImageView
				android:id="@+id/imageView_before"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:padding="2dp"
				android:scaleType="centerCrop"
				app:allowRgb565="false"
				app:decodeRegion="true"
				app:layout_constraintDimensionRatio="W,14:9"
				app:layout_constraintEnd_toStartOf="@id/imageView_arrow"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent"
				app:shapeAppearance="?shapeAppearanceCornerLarge"
				app:strokeColor="?colorOutline"
				app:strokeWidth="1dp"
				tools:src="@tools:sample/backgrounds/scenic" />

			<com.google.android.material.progressindicator.CircularProgressIndicator
				android:id="@+id/progress_before"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:indeterminate="true"
				app:layout_constraintBottom_toBottomOf="@id/imageView_before"
				app:layout_constraintEnd_toEndOf="@id/imageView_before"
				app:layout_constraintStart_toStartOf="@id/imageView_before"
				app:layout_constraintTop_toTopOf="@id/imageView_before" />

			<ImageView
				android:id="@+id/imageView_arrow"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:contentDescription="@null"
				android:padding="@dimen/margin_normal"
				android:src="@drawable/ic_arrow_forward"
				app:layout_constraintBottom_toBottomOf="@id/imageView_before"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="@id/imageView_before" />

			<com.google.android.material.imageview.ShapeableImageView
				android:id="@+id/imageView_after"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:padding="2dp"
				android:scaleType="centerCrop"
				app:layout_constraintDimensionRatio="W,14:9"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toEndOf="@id/imageView_arrow"
				app:layout_constraintTop_toTopOf="parent"
				app:shapeAppearance="?shapeAppearanceCornerLarge"
				app:strokeColor="?colorOutline"
				app:strokeWidth="1dp"
				tools:src="@tools:sample/backgrounds/scenic" />

			<com.google.android.material.progressindicator.CircularProgressIndicator
				android:id="@+id/progress_after"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:indeterminate="true"
				app:layout_constraintBottom_toBottomOf="@id/imageView_after"
				app:layout_constraintEnd_toEndOf="@id/imageView_after"
				app:layout_constraintStart_toStartOf="@id/imageView_after"
				app:layout_constraintTop_toTopOf="@id/imageView_after" />

			<TextView
				android:id="@+id/header_color_tone"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:text="@string/filter_category_color_tone"
				android:textAppearance="?textAppearanceTitleMedium"
				android:textColor="?colorPrimary"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/imageView_before" />

			<TextView
				android:id="@+id/subtitle_color_tone"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:text="@string/filter_category_color_tone_subtitle"
				android:textAppearance="?textAppearanceBodySmall"
				android:textColor="?colorOnSurfaceVariant"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/header_color_tone" />

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switch_invert"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:minHeight="48dp"
				android:layout_marginTop="4dp"
				android:text="@string/invert_colors"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toStartOf="@id/info_invert"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/subtitle_color_tone" />

			<ImageButton
				android:id="@+id/info_invert"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_info_outline"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/switch_invert" />

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switch_grayscale"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:minHeight="48dp"
				android:layout_marginTop="4dp"
				android:text="@string/grayscale"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toStartOf="@id/info_grayscale"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/switch_invert" />

			<ImageButton
				android:id="@+id/info_grayscale"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_info_outline"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/switch_grayscale" />

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switch_book"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:minHeight="48dp"
				android:layout_marginTop="4dp"
				android:text="@string/book_effect"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toStartOf="@id/info_book"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/switch_grayscale" />

			<ImageButton
				android:id="@+id/info_book"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_info_outline"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/switch_book" />

			<TextView
				android:id="@+id/textView_brightness"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:minHeight="48dp"
				android:gravity="center_vertical"
				android:layout_marginTop="@dimen/margin_small"
				android:labelFor="@id/slider_brightness"
				android:text="@string/brightness"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toStartOf="@id/info_brightness"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/switch_book" />

			<ImageButton
				android:id="@+id/info_brightness"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_info_outline"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/textView_brightness" />

			<ImageButton
				android:id="@+id/button_brightness_minus"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_remove"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/textView_brightness" />

			<com.google.android.material.slider.Slider
				android:id="@+id/slider_brightness"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:value="0.0"
				android:valueFrom="-1.0"
				android:valueTo="1.0"
				app:layout_constraintBottom_toBottomOf="@id/button_brightness_minus"
				app:layout_constraintEnd_toStartOf="@id/button_brightness_plus"
				app:layout_constraintStart_toEndOf="@id/button_brightness_minus"
				app:layout_constraintTop_toTopOf="@id/button_brightness_minus" />

			<ImageButton
				android:id="@+id/button_brightness_plus"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_add"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/button_brightness_minus" />

			<TextView
				android:id="@+id/textView_contrast"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:minHeight="48dp"
				android:gravity="center_vertical"
				android:layout_marginTop="@dimen/margin_small"
				android:labelFor="@id/slider_contrast"
				android:text="@string/contrast"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toStartOf="@id/info_contrast"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/button_brightness_minus" />

			<ImageButton
				android:id="@+id/info_contrast"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_info_outline"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/textView_contrast" />

			<ImageButton
				android:id="@+id/button_contrast_minus"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_remove"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/textView_contrast" />

			<com.google.android.material.slider.Slider
				android:id="@+id/slider_contrast"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:value="0.0"
				android:valueFrom="-1.0"
				android:valueTo="1.0"
				app:layout_constraintBottom_toBottomOf="@id/button_contrast_minus"
				app:layout_constraintEnd_toStartOf="@id/button_contrast_plus"
				app:layout_constraintStart_toEndOf="@id/button_contrast_minus"
				app:layout_constraintTop_toTopOf="@id/button_contrast_minus" />

			<ImageButton
				android:id="@+id/button_contrast_plus"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_add"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/button_contrast_minus" />

			<TextView
				android:id="@+id/textView_saturation"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:minHeight="48dp"
				android:gravity="center_vertical"
				android:layout_marginTop="@dimen/margin_small"
				android:labelFor="@id/slider_saturation"
				android:text="@string/saturation"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toStartOf="@id/info_saturation"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/button_contrast_minus" />

			<ImageButton
				android:id="@+id/info_saturation"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_info_outline"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/textView_saturation" />

			<ImageButton
				android:id="@+id/button_saturation_minus"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_remove"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/textView_saturation" />

			<com.google.android.material.slider.Slider
				android:id="@+id/slider_saturation"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:value="0.0"
				android:valueFrom="-1.0"
				android:valueTo="1.0"
				app:layout_constraintBottom_toBottomOf="@id/button_saturation_minus"
				app:layout_constraintEnd_toStartOf="@id/button_saturation_plus"
				app:layout_constraintStart_toEndOf="@id/button_saturation_minus"
				app:layout_constraintTop_toTopOf="@id/button_saturation_minus" />

			<ImageButton
				android:id="@+id/button_saturation_plus"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_add"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/button_saturation_minus" />

			<TextView
				android:id="@+id/textView_vibrance"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:minHeight="48dp"
				android:gravity="center_vertical"
				android:layout_marginTop="@dimen/margin_small"
				android:labelFor="@id/slider_vibrance"
				android:text="@string/vibrance"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toStartOf="@id/info_vibrance"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/button_saturation_minus" />

			<ImageButton
				android:id="@+id/info_vibrance"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_info_outline"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/textView_vibrance" />

			<ImageButton
				android:id="@+id/button_vibrance_minus"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_remove"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/textView_vibrance" />

			<com.google.android.material.slider.Slider
				android:id="@+id/slider_vibrance"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:value="0.0"
				android:valueFrom="0.0"
				android:valueTo="1.0"
				app:layout_constraintBottom_toBottomOf="@id/button_vibrance_minus"
				app:layout_constraintEnd_toStartOf="@id/button_vibrance_plus"
				app:layout_constraintStart_toEndOf="@id/button_vibrance_minus"
				app:layout_constraintTop_toTopOf="@id/button_vibrance_minus" />

			<ImageButton
				android:id="@+id/button_vibrance_plus"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_add"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/button_vibrance_minus" />

			<TextView
				android:id="@+id/header_clarity"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_normal"
				android:text="@string/filter_category_clarity"
				android:textAppearance="?textAppearanceTitleMedium"
				android:textColor="?colorPrimary"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/button_vibrance_minus" />

			<TextView
				android:id="@+id/subtitle_clarity"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:text="@string/filter_category_clarity_subtitle"
				android:textAppearance="?textAppearanceBodySmall"
				android:textColor="?colorOnSurfaceVariant"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/header_clarity" />

			<TextView
				android:id="@+id/textView_rcas"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:minHeight="48dp"
				android:gravity="center_vertical"
				android:layout_marginTop="@dimen/margin_small"
				android:labelFor="@id/slider_rcas"
				android:text="@string/sharpen_rcas"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toStartOf="@id/info_rcas"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/subtitle_clarity" />

			<ImageButton
				android:id="@+id/info_rcas"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_info_outline"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/textView_rcas" />

			<ImageButton
				android:id="@+id/button_rcas_minus"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_remove"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/textView_rcas" />

			<com.google.android.material.slider.Slider
				android:id="@+id/slider_rcas"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:value="0.0"
				android:valueFrom="0.0"
				android:valueTo="1.0"
				app:layout_constraintBottom_toBottomOf="@id/button_rcas_minus"
				app:layout_constraintEnd_toStartOf="@id/button_rcas_plus"
				app:layout_constraintStart_toEndOf="@id/button_rcas_minus"
				app:layout_constraintTop_toTopOf="@id/button_rcas_minus" />

			<ImageButton
				android:id="@+id/button_rcas_plus"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_add"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/button_rcas_minus" />

			<TextView
				android:id="@+id/textView_adaptive_sharpen"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:minHeight="48dp"
				android:gravity="center_vertical"
				android:layout_marginTop="@dimen/margin_small"
				android:labelFor="@id/slider_adaptive_sharpen"
				android:text="@string/sharpen_adaptive_sharpen"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toStartOf="@id/info_adaptive_sharpen"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/button_rcas_minus" />

			<ImageButton
				android:id="@+id/info_adaptive_sharpen"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_info_outline"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/textView_adaptive_sharpen" />

			<ImageButton
				android:id="@+id/button_adaptive_sharpen_minus"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_remove"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/textView_adaptive_sharpen" />

			<com.google.android.material.slider.Slider
				android:id="@+id/slider_adaptive_sharpen"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:value="0.0"
				android:valueFrom="0.0"
				android:valueTo="1.0"
				app:layout_constraintBottom_toBottomOf="@id/button_adaptive_sharpen_minus"
				app:layout_constraintEnd_toStartOf="@id/button_adaptive_sharpen_plus"
				app:layout_constraintStart_toEndOf="@id/button_adaptive_sharpen_minus"
				app:layout_constraintTop_toTopOf="@id/button_adaptive_sharpen_minus" />

			<ImageButton
				android:id="@+id/button_adaptive_sharpen_plus"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_add"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/button_adaptive_sharpen_minus" />

			<TextView
				android:id="@+id/header_cleanup"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_normal"
				android:text="@string/filter_category_cleanup"
				android:textAppearance="?textAppearanceTitleMedium"
				android:textColor="?colorPrimary"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/button_adaptive_sharpen_minus" />

			<TextView
				android:id="@+id/subtitle_cleanup"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:text="@string/filter_category_cleanup_subtitle"
				android:textAppearance="?textAppearanceBodySmall"
				android:textColor="?colorOnSurfaceVariant"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/header_cleanup" />

			<TextView
				android:id="@+id/textView_deband"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:minHeight="48dp"
				android:gravity="center_vertical"
				android:layout_marginTop="@dimen/margin_small"
				android:labelFor="@id/slider_deband"
				android:text="@string/deband"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toStartOf="@id/info_deband"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/subtitle_cleanup" />

			<ImageButton
				android:id="@+id/info_deband"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_info_outline"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/textView_deband" />

			<ImageButton
				android:id="@+id/button_deband_minus"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_remove"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/textView_deband" />

			<com.google.android.material.slider.Slider
				android:id="@+id/slider_deband"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:value="0.0"
				android:valueFrom="0.0"
				android:valueTo="1.0"
				app:layout_constraintBottom_toBottomOf="@id/button_deband_minus"
				app:layout_constraintEnd_toStartOf="@id/button_deband_plus"
				app:layout_constraintStart_toEndOf="@id/button_deband_minus"
				app:layout_constraintTop_toTopOf="@id/button_deband_minus" />

			<ImageButton
				android:id="@+id/button_deband_plus"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_add"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/button_deband_minus" />

			<TextView
				android:id="@+id/textView_denoise"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:minHeight="48dp"
				android:gravity="center_vertical"
				android:layout_marginTop="@dimen/margin_small"
				android:labelFor="@id/slider_denoise"
				android:text="@string/denoise"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toStartOf="@id/info_denoise"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/button_deband_minus" />

			<ImageButton
				android:id="@+id/info_denoise"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_info_outline"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/textView_denoise" />

			<ImageButton
				android:id="@+id/button_denoise_minus"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_remove"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/textView_denoise" />

			<com.google.android.material.slider.Slider
				android:id="@+id/slider_denoise"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:value="0.0"
				android:valueFrom="0.0"
				android:valueTo="1.0"
				app:layout_constraintBottom_toBottomOf="@id/button_denoise_minus"
				app:layout_constraintEnd_toStartOf="@id/button_denoise_plus"
				app:layout_constraintStart_toEndOf="@id/button_denoise_minus"
				app:layout_constraintTop_toTopOf="@id/button_denoise_minus" />

			<ImageButton
				android:id="@+id/button_denoise_plus"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_add"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/button_denoise_minus" />

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switch_line_darken"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:minHeight="48dp"
				android:layout_marginTop="4dp"
				android:text="@string/line_darkening"
				android:textAppearance="?textAppearanceTitleMedium"
				app:layout_constraintEnd_toStartOf="@id/info_line_darken"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toBottomOf="@id/button_denoise_minus" />

			<ImageButton
				android:id="@+id/info_line_darken"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?selectableItemBackgroundBorderless"
				android:src="@drawable/ic_info_outline"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="@id/switch_line_darken" />

			<Button
				android:id="@+id/button_reset"
				style="?materialButtonOutlinedStyle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:text="@string/reset"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toBottomOf="@id/switch_line_darken" />

		</androidx.constraintlayout.widget.ConstraintLayout>

	</ScrollView>

</LinearLayout>
