<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:title="@string/reader_settings">

	<ListPreference
		android:entries="@array/reader_modes"
		android:icon="@drawable/ic_reader_ltr"
		android:key="reader_mode"
		android:title="@string/default_mode"
		app:useSimpleSummaryProvider="true" />

	<SwitchPreferenceCompat
		android:defaultValue="true"
		android:icon="@drawable/ic_auto_fix"
		android:key="reader_mode_detect"
		android:summary="@string/detect_reader_mode_summary"
		android:title="@string/detect_reader_mode" />

	<ListPreference
		android:entries="@array/zoom_modes"
		android:icon="@drawable/ic_zoom_in"
		android:key="zoom_mode"
		android:title="@string/scale_mode"
		app:allowDividerAbove="true"
		app:useSimpleSummaryProvider="true" />

	<ListPreference
		android:entries="@array/zoom_starts"
		android:icon="@drawable/ic_zoom_in"
		android:key="zoom_start"
		android:title="@string/zoom_start"
		app:useSimpleSummaryProvider="true" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:icon="@drawable/ic_zoom_in"
		android:key="landscape_zoom"
		android:summary="@string/landscape_zoom_summary"
		android:title="@string/landscape_zoom" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:icon="@drawable/ic_zoom_in"
		android:key="tap_to_pan"
		android:summary="@string/tap_to_pan_summary"
		android:title="@string/tap_to_pan" />

	<SwitchPreferenceCompat
		android:defaultValue="true"
		android:icon="@drawable/ic_zoom_in"
		android:key="reader_double_tap_zoom"
		android:summary="@string/double_tap_zoom_summary"
		android:title="@string/double_tap_zoom" />

	<ListPreference
		android:defaultValue="0"
		android:dependency="reader_double_tap_zoom"
		android:entries="@array/double_tap_speeds"
		android:entryValues="@array/double_tap_speed_values"
		android:icon="@drawable/ic_zoom_in"
		android:key="reader_double_tap_speed"
		android:title="@string/double_tap_zoom_speed"
		app:useSimpleSummaryProvider="true" />

	<ListPreference
		android:entries="@array/reader_hide_thresholds"
		android:icon="@drawable/ic_zoom_out"
		android:key="reader_hide_threshold"
		android:title="@string/reader_hide_threshold"
		app:useSimpleSummaryProvider="true" />

	<org.koitharu.kotatsu.settings.utils.SliderPreference
		android:icon="@drawable/ic_appearance"
		android:key="reader_brightness"
		android:stepSize="5"
		android:title="@string/reader_brightness"
		android:valueFrom="0"
		android:valueTo="100"
		app:defaultValue="0" />

	<org.koitharu.kotatsu.settings.utils.SliderPreference
		android:icon="@drawable/ic_appearance"
		android:key="reader_dim"
		android:stepSize="5"
		android:title="@string/reader_dim"
		android:valueFrom="0"
		android:valueTo="80"
		app:defaultValue="0" />

	<ListPreference
		android:entries="@array/reader_tints"
		android:icon="@drawable/ic_appearance"
		android:key="reader_tint"
		android:title="@string/reader_tint"
		app:useSimpleSummaryProvider="true" />

	<org.koitharu.kotatsu.settings.utils.SliderPreference
		android:dependency="reader_tint"
		android:icon="@drawable/ic_appearance"
		android:key="reader_tint_strength"
		android:stepSize="5"
		android:title="@string/reader_tint_strength"
		android:valueFrom="0"
		android:valueTo="60"
		app:defaultValue="25" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:icon="@drawable/ic_zoom_out"
		android:key="reader_zoom_buttons"
		android:summary="@string/reader_zoom_buttons_summary"
		android:title="@string/reader_zoom_buttons" />

	<SwitchPreferenceCompat
		android:defaultValue="true"
		android:icon="@drawable/ic_reader_vertical"
		android:key="webtoon_zoom"
		android:summary="@string/webtoon_zoom_summary"
		android:title="@string/webtoon_zoom" />

	<org.koitharu.kotatsu.settings.utils.SliderPreference
		android:dependency="webtoon_zoom"
		android:icon="@drawable/ic_size_large"
		android:key="webtoon_zoom_out"
		android:stepSize="10"
		android:title="@string/default_webtoon_zoom_out"
		android:valueFrom="0"
		android:valueTo="50"
		app:defaultValue="0"
		app:tickVisible="true" />

	<org.koitharu.kotatsu.settings.utils.SliderPreference
		android:icon="@drawable/ic_split_horizontal"
		android:key="double_page_gap"
		android:stepSize="1"
		android:title="@string/double_page_gap"
		android:valueFrom="0"
		android:valueTo="10"
		app:defaultValue="0" />

	<org.koitharu.kotatsu.settings.utils.SliderPreference
		android:icon="@drawable/ic_split_horizontal"
		android:key="webtoon_side_padding"
		android:stepSize="1"
		android:title="@string/webtoon_side_padding"
		android:valueFrom="0"
		android:valueTo="25"
		app:defaultValue="0" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:icon="@drawable/ic_split_horizontal"
		android:key="webtoon_gaps"
		android:summary="@string/webtoon_gaps_summary"
		android:title="@string/webtoon_gaps" />

	<MultiSelectListPreference
		android:entries="@array/reader_controls"
		android:icon="@drawable/ic_tap"
		android:key="reader_controls"
		android:title="@string/reader_controls_in_bottom_bar"
		app:allowDividerAbove="true" />

	<Preference
		android:icon="@drawable/ic_tap_reorder"
		android:key="reader_tap_actions"
		android:persistent="false"
		android:summary="@string/reader_actions_summary"
		android:title="@string/reader_actions" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:icon="@drawable/ic_reader_rtl"
		android:key="reader_taps_ltr"
		android:summary="@string/reader_control_ltr_summary"
		android:title="@string/reader_control_ltr" />

	<ListPreference
		android:defaultValue="0"
		android:entries="@array/reader_tap_inversion"
		android:entryValues="@array/values_reader_tap_inversion"
		android:icon="@drawable/ic_revert"
		android:key="reader_tap_inversion"
		android:summary="@string/reader_tap_inversion_summary"
		android:title="@string/reader_tap_inversion"
		app:useSimpleSummaryProvider="false" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:icon="@drawable/ic_gesture_vertical"
		android:key="reader_volume_buttons"
		android:summary="@string/switch_pages_volume_buttons_summary"
		android:title="@string/switch_pages_volume_buttons" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:icon="@drawable/ic_revert"
		android:key="reader_navigation_inverted"
		android:summary="@string/reader_navigation_inverted_summary"
		android:title="@string/reader_navigation_inverted" />

	<ListPreference
		android:entries="@array/reader_animation"
		android:icon="@drawable/ic_auto_fix"
		android:key="reader_animation2"
		android:title="@string/pages_animation"
		app:useSimpleSummaryProvider="true" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:icon="@drawable/ic_gesture_vertical"
        android:key="webtoon_pull_gesture"
        android:summary="@string/enable_pull_gesture_summary"
        android:title="@string/enable_pull_gesture_title" />

	<ListPreference
		android:entries="@array/reader_scaler"
		android:icon="@drawable/ic_auto_fix"
		android:key="reader_scaler"
		android:title="@string/reader_scaler"
		app:useSimpleSummaryProvider="true" />

	<SwitchPreferenceCompat
		android:defaultValue="true"
		android:icon="@drawable/ic_auto_fix"
		android:key="reader_smart_sharpen"
		android:summary="@string/reader_smart_sharpen_summary"
		android:title="@string/reader_smart_sharpen" />

	<ListPreference
		android:entries="@array/reader_downscaler"
		android:icon="@drawable/ic_auto_fix"
		android:key="reader_downscaler"
		android:title="@string/reader_downscaler"
		app:useSimpleSummaryProvider="true" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:icon="@drawable/ic_appearance"
		android:key="enhanced_colors"
		android:summary="@string/enhanced_colors_summary"
		android:title="@string/enhanced_colors"
		app:allowDividerAbove="true" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:icon="@drawable/ic_auto_fix"
		android:key="reader_optimize"
		android:summary="@string/reader_optimize_summary"
		android:title="@string/reader_optimize" />

	<MultiSelectListPreference
		android:entries="@array/reader_crop"
		android:entryValues="@array/values_reader_crop"
		android:icon="@drawable/ic_crop"
		android:key="reader_crop"
		android:title="@string/crop_pages" />

	<org.koitharu.kotatsu.settings.utils.SliderPreference
		android:icon="@drawable/ic_crop"
		android:key="reader_crop_tolerance"
		android:stepSize="2"
		android:summary="@string/crop_tolerance_summary"
		android:title="@string/crop_tolerance"
		android:valueFrom="0"
		android:valueTo="64"
		app:defaultValue="16" />

	<org.koitharu.kotatsu.settings.utils.SliderPreference
		android:icon="@drawable/ic_size_large"
		android:key="reader_tile_dpi"
		android:stepSize="20"
		android:summary="@string/reader_tile_dpi_summary"
		android:title="@string/reader_tile_dpi"
		android:valueFrom="160"
		android:valueTo="400"
		app:defaultValue="320" />

	<ListPreference
		android:defaultValue="0"
		android:entries="@array/png_decoder_entries"
		android:entryValues="@array/png_decoder_values"
		android:icon="@drawable/ic_images"
		android:key="reader_png_decoder"
		android:summary="@string/png_decoder_summary"
		android:title="@string/png_decoder" />

	<PreferenceCategory
		android:title="@string/hidden_images"
		app:allowDividerAbove="true">

		<SwitchPreferenceCompat
			android:defaultValue="true"
			android:icon="@drawable/ic_delete"
			android:key="reader_erase_gesture"
			android:summary="@string/erase_gesture_summary"
			android:title="@string/erase_gesture" />

		<Preference
			android:icon="@drawable/ic_info_outline"
			android:key="erase_tutorial"
			android:persistent="false"
			android:summary="@string/erase_tutorial_again_summary"
			android:title="@string/erase_tutorial_again" />

		<PreferenceScreen
			android:fragment="org.koitharu.kotatsu.reader.ui.erase.HiddenImagesFragment"
			android:icon="@drawable/ic_eye_off"
			android:key="hidden_images"
			android:summary="@string/hidden_images_summary"
			android:title="@string/hidden_images" />

	</PreferenceCategory>

	<PreferenceCategory
		android:title="@string/e_ink"
		app:allowDividerAbove="true">

		<SwitchPreferenceCompat
			android:defaultValue="false"
			android:icon="@drawable/ic_flash"
			android:key="eink_flash"
			android:summary="@string/flash_on_page_change_summary"
			android:title="@string/flash_on_page_change" />

		<org.koitharu.kotatsu.settings.utils.SliderPreference
			android:dependency="eink_flash"
			android:icon="@drawable/ic_timer"
			android:key="eink_flash_duration"
			android:stepSize="50"
			android:title="@string/flash_duration"
			android:valueFrom="100"
			android:valueTo="1000"
			app:defaultValue="300" />

		<org.koitharu.kotatsu.settings.utils.SliderPreference
			android:dependency="eink_flash"
			android:icon="@drawable/ic_timelapse"
			android:key="eink_flash_every"
			android:stepSize="1"
			android:title="@string/flash_every"
			android:valueFrom="1"
			android:valueTo="10"
			app:defaultValue="1"
			app:tickVisible="true" />

		<ListPreference
			android:dependency="eink_flash"
			android:icon="@drawable/ic_appearance"
			android:key="eink_flash_color"
			android:title="@string/flash_with"
			app:useSimpleSummaryProvider="true" />

	</PreferenceCategory>

	<SwitchPreferenceCompat
		android:defaultValue="true"
		android:icon="@drawable/ic_fullscreen"
		android:key="reader_fullscreen"
		android:summary="@string/reader_fullscreen_summary"
		android:title="@string/fullscreen_mode"
		app:allowDividerAbove="true" />

	<ListPreference
		android:entries="@array/screen_orientations"
		android:icon="@drawable/ic_screen_rotation"
		android:key="reader_orientation"
		android:title="@string/screen_orientation"
		app:useSimpleSummaryProvider="true" />

	<SwitchPreferenceCompat
		android:defaultValue="true"
		android:icon="@drawable/ic_eye"
		android:key="reader_screen_on"
		android:summary="@string/keep_screen_on_summary"
		android:title="@string/keep_screen_on" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:icon="@drawable/ic_split_horizontal"
		android:key="reader_multitask"
		android:summary="@string/reader_multitask_summary"
		android:title="@string/reader_multitask" />

	<SwitchPreferenceCompat
		android:defaultValue="true"
		android:icon="@drawable/ic_info_outline"
		android:key="reader_bar"
		android:summary="@string/reader_info_bar_summary"
		android:title="@string/reader_info_bar"
		app:allowDividerAbove="true" />

	<SwitchPreferenceCompat
		android:defaultValue="true"
		android:dependency="reader_bar"
		android:icon="@drawable/ic_eye_off"
		android:key="reader_bar_transparent"
		android:title="@string/reader_info_bar_transparent" />

	<SwitchPreferenceCompat
		android:defaultValue="true"
		android:icon="@drawable/ic_notification"
		android:key="reader_chapter_toast"
		android:summary="@string/reader_chapter_toast_summary"
		android:title="@string/reader_chapter_toast" />

	<SwitchPreferenceCompat
		android:defaultValue="true"
		android:icon="@drawable/ic_notification"
		android:key="reader_missing_warn"
		android:summary="@string/missing_chapters_warning_summary"
		android:title="@string/missing_chapters_warning" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:icon="@drawable/ic_next"
		android:key="reader_skip_dupes"
		android:summary="@string/skip_duplicate_chapters_summary"
		android:title="@string/skip_duplicate_chapters" />

	<ListPreference
		android:entries="@array/reader_backgrounds"
		android:icon="@drawable/ic_appearance"
		android:key="reader_background"
		android:title="@string/background"
		app:allowDividerAbove="true"
		app:useSimpleSummaryProvider="true" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:icon="@drawable/ic_book_page"
		android:key="pages_numbers"
		android:summary="@string/show_pages_numbers_summary"
		android:title="@string/show_pages_numbers" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:icon="@drawable/ic_storage"
		android:key="memory_saver"
		android:summary="@string/memory_saver_summary"
		android:title="@string/memory_saver" />

	<SwitchPreferenceCompat
		android:defaultValue="true"
		android:icon="@drawable/ic_play"
		android:key="reader_animated"
		android:summary="@string/animated_images_summary"
		android:title="@string/animated_images" />

	<SwitchPreferenceCompat
		android:defaultValue="true"
		android:dependency="reader_animated"
		android:icon="@drawable/ic_play"
		android:key="reader_animated_autoplay"
		android:summary="@string/animated_autoplay_summary"
		android:title="@string/animated_autoplay" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:dependency="reader_animated"
		android:icon="@drawable/ic_play"
		android:key="details_cover_animated"
		android:summary="@string/details_cover_animated_summary"
		android:title="@string/details_cover_animated" />

	<SwitchPreferenceCompat
		android:defaultValue="true"
		android:dependency="reader_animated"
		android:icon="@drawable/ic_play"
		android:key="reader_animated_controls"
		android:summary="@string/animated_controls_summary"
		android:title="@string/animated_controls" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:dependency="reader_animated"
		android:icon="@drawable/ic_next"
		android:key="reader_animated_advance"
		android:summary="@string/animated_advance_summary"
		android:title="@string/animated_advance" />

	<ListPreference
		android:defaultValue="1"
		android:dependency="reader_animated"
		android:entries="@array/animated_speed_entries"
		android:entryValues="@array/animated_speed_values"
		android:icon="@drawable/ic_play"
		android:key="reader_animated_speed"
		android:title="@string/animated_speed"
		app:useSimpleSummaryProvider="true" />

	<ListPreference
		android:defaultValue="-1"
		android:dependency="reader_animated"
		android:entries="@array/animated_loops_entries"
		android:entryValues="@array/animated_loops_values"
		android:icon="@drawable/ic_play"
		android:key="reader_animated_loops"
		android:title="@string/animated_loops"
		app:useSimpleSummaryProvider="true" />

	<ListPreference
		android:defaultValue="2"
		android:entries="@array/network_policy"
		android:entryValues="@array/values_network_policy"
		android:icon="@drawable/ic_download"
		android:key="pages_preload"
		android:title="@string/preload_pages"
		app:useSimpleSummaryProvider="true" />

</PreferenceScreen>
