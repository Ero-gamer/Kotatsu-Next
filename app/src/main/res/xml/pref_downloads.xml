<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:title="@string/downloads"
	xmlns:app="http://schemas.android.com/apk/res-auto">

	<Preference
		android:icon="@drawable/ic_folder_file"
		android:key="local_manga_dirs"
		android:persistent="false"
		android:title="@string/local_manga_directories" />

	<Preference
		android:icon="@drawable/ic_storage"
		android:key="local_storage"
		android:persistent="false"
		android:title="@string/manga_save_location" />

	<ListPreference
		android:entries="@array/download_formats"
		android:icon="@drawable/ic_file_zip"
		android:key="downloads_format"
		android:title="@string/preferred_download_format"
		app:useSimpleSummaryProvider="true" />

	<ListPreference
		android:entries="@array/metered_network_options"
		android:icon="@drawable/ic_network_cellular"
		android:key="downloads_metered_network"
		android:title="@string/download_over_cellular"
		app:useSimpleSummaryProvider="true" />

	<ListPreference
		android:defaultValue="0"
		android:entries="@array/download_ahead_counts"
		android:entryValues="@array/download_ahead_count_values"
		android:icon="@drawable/ic_download"
		android:key="download_ahead"
		android:summary="@string/download_ahead_summary"
		android:title="@string/download_ahead" />

	<Preference
		android:icon="@drawable/ic_info_outline"
		android:key="tracker_notifications_info"
		android:persistent="false"
		android:selectable="false"
		android:summary="@string/downloads_settings_info" />

	<Preference
		android:icon="@drawable/ic_battery_outline"
		android:key="ignore_dose"
		android:persistent="false"
		android:summary="@string/disable_battery_optimization_summary_downloads"
		android:title="@string/disable_battery_optimization"
		app:allowDividerAbove="true"
		app:isPreferenceVisible="false" />

	<PreferenceCategory android:title="@string/pages_saving">

		<Preference
			android:icon="@drawable/ic_folder_file"
			android:key="pages_dir"
			android:persistent="false"
			android:title="@string/default_page_save_dir" />

		<SwitchPreferenceCompat
			android:defaultValue="true"
			android:icon="@drawable/ic_edit"
			android:key="pages_dir_ask"
			android:title="@string/ask_for_dest_dir_every_time" />

	</PreferenceCategory>

	<PreferenceCategory android:title="@string/tall_split">

		<SwitchPreferenceCompat
			android:defaultValue="false"
			android:icon="@drawable/ic_storage"
			android:key="split_tall_images"
			android:summary="@string/tall_split_summary"
			android:title="@string/tall_split" />

		<SwitchPreferenceCompat
			android:defaultValue="true"
			android:icon="@drawable/ic_appearance"
			android:key="webp_quality_auto"
			android:summary="@string/webp_quality_auto_summary"
			android:title="@string/webp_quality_auto" />

		<SwitchPreferenceCompat
			android:defaultValue="false"
			android:icon="@drawable/ic_storage"
			android:key="convert_webp_download"
			android:summary="@string/convert_webp_download_summary"
			android:title="@string/convert_webp_download" />

		<org.koitharu.kotatsu.settings.utils.SliderPreference
			android:dependency="split_tall_images"
			android:icon="@drawable/ic_appearance"
			android:key="tall_split_quality"
			android:stepSize="5"
			android:title="@string/tall_split_quality"
			android:valueFrom="50"
			android:valueTo="100"
			app:defaultValue="95" />

		<ListPreference
			android:defaultValue="off"
			android:entries="@array/dual_split_modes"
			android:entryValues="@array/values_dual_split"
			android:icon="@drawable/ic_storage"
			android:key="split_dual_pages"
			android:summary="@string/dual_split_summary"
			android:title="@string/dual_split" />

	</PreferenceCategory>

	<PreferenceCategory android:title="@string/archive_maintenance">

		<SwitchPreferenceCompat
			android:defaultValue="false"
			android:icon="@drawable/ic_storage"
			android:key="cbz_auto_repack"
			android:summary="@string/cbz_auto_repack_summary"
			android:title="@string/cbz_auto_repack" />

		<Preference
			android:icon="@drawable/ic_images"
			android:key="optimize_screen"
			android:persistent="false"
			android:summary="@string/optimize_screen_summary"
			android:title="@string/optimize_screen_title" />

		<Preference
			android:icon="@drawable/ic_images"
			android:key="optimize_all"
			android:persistent="false"
			android:summary="@string/optimize_all_downloads_summary"
			android:title="@string/optimize_all_downloads" />

		<Preference
			android:icon="@drawable/ic_storage"
			android:key="cbz_repack_stored"
			android:persistent="false"
			android:summary="@string/repack_stored_summary"
			android:title="@string/repack_stored" />

		<Preference
			android:icon="@drawable/ic_edit"
			android:key="cbz_fix_extensions"
			android:persistent="false"
			android:summary="@string/fix_extensions_summary"
			android:title="@string/fix_extensions" />

	</PreferenceCategory>

</PreferenceScreen>
